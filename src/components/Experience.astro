---
import { EXPERIENCES } from '../data/portfolioData';
---

<section id="experience" class="py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-800">
  <div class="space-y-4 mb-10">
    <div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-sm font-bold uppercase tracking-wider">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
      <span>Parcours</span>
    </div>
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 tracking-tight">
      Expériences Professionnelles
    </h2>
  </div>

  <div class="relative border-l-2 border-indigo-200 dark:border-indigo-900/60 ml-4 md:ml-6 space-y-10">
    {EXPERIENCES.map((exp) => (
      <div class="relative pl-6 sm:pl-8 group">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-zinc-950 border-2 border-indigo-600 dark:border-indigo-400 group-hover:scale-125 transition-transform"></div>

        <div class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <div>
              <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">{exp.role}</h3>
              <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400">{exp.company} — {exp.location}</p>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 self-start sm:self-center">
              {exp.period}
            </span>
          </div>

          <ul class="list-disc list-inside space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {exp.achievements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 border border-indigo-200 dark:border-indigo-800/80 text-xs font-semibold text-indigo-700 dark:text-indigo-300">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            <span>Impact mesuré : {exp.metrics}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
