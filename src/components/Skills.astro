---
import { SKILL_CATEGORIES } from '../data/portfolioData';
---

<section id="skills" class="py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-800">
  <div class="space-y-4 mb-10">
    <div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-sm font-bold uppercase tracking-wider">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      <span>Compétences & Stack</span>
    </div>
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 tracking-tight">
      Arsenal Technique & Savoir-faire
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {SKILL_CATEGORIES.map((category) => (
      <div class="p-6 rounded-xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 hover:border-indigo-500/50 transition-colors">
        <h3 class="text-lg font-bold text-zinc-800 dark:text-zinc-100 mb-4 flex items-center justify-between">
          <span>{category.categoryName}</span>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300">
            {category.skills.length} technos
          </span>
        </h3>
        <div class="flex flex-wrap gap-2">
          {category.skills.map((skill) => (
            <span class="px-3 py-1 text-xs font-medium rounded-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 shadow-sm">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
