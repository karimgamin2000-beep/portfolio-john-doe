---
import { TESTIMONIALS } from '../data/portfolioData';
---

<section id="testimonials" class="py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-zinc-200 dark:border-zinc-800">
  <div class="space-y-4 mb-10">
    <div class="inline-flex items-center gap-2 text-indigo-600 dark:text-indigo-400 text-sm font-bold uppercase tracking-wider">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
      <span>Recommandations</span>
    </div>
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 tracking-tight">
      Ce que disent mes pairs
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {TESTIMONIALS.map((t) => (
      <article class="p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between hover:border-indigo-500/50 transition-colors shadow-sm">
        <blockquote class="text-sm text-zinc-600 dark:text-zinc-300 italic leading-relaxed mb-6">
          “{t.quote}”
        </blockquote>

        <div class="flex items-center gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800/80">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xs shadow-sm flex-shrink-0">
            {t.avatarInitials}
          </div>
          <div>
            <cite class="not-italic font-bold text-sm text-zinc-900 dark:text-zinc-100 block">{t.author}</cite>
            <span class="text-xs text-indigo-600 dark:text-indigo-400 font-medium block">{t.role} • {t.company}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
