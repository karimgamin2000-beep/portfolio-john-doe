---
---

<section id="contact" class="py-16 px-4 sm:px-6 max-w-4xl mx-auto border-t border-zinc-200 dark:border-zinc-800">
  <div class="text-center space-y-3 mb-10">
    <h2 class="text-3xl font-bold text-zinc-900 dark:text-zinc-50 tracking-tight">Me Contacter</h2>
    <p class="text-sm text-zinc-600 dark:text-zinc-400">
      Une opportunité technique ou un projet d’envergure ? Envoyez-moi un message direct ou écrivez à 
      <a
        href="mailto:vagehe1989@bowlfuel.com"
        class="text-indigo-600 dark:text-indigo-400 hover:underline font-semibold"
      >
        vagehe1989@bowlfuel.com
      </a>.
    </p>
  </div>

  <form
    id="contact-form"
    class="space-y-5 bg-zinc-50 dark:bg-zinc-900/50 p-6 sm:p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800"
  >
    <!-- Message de notification -->
    <div id="form-feedback" class="hidden p-4 rounded-lg text-sm flex items-center gap-3 border" role="alert">
      <span id="feedback-icon"></span>
      <span id="feedback-text"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
          Nom complet *
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full px-4 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          placeholder="ex: Sophie Martin"
        />
      </div>

      <div>
        <label for="email" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
          Adresse Email *
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full px-4 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
          placeholder="sophie@example.com"
        />
      </div>
    </div>

    <div>
      <label for="subject" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
        Sujet
      </label>
      <input
        id="subject"
        name="subject"
        type="text"
        class="w-full px-4 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        placeholder="Proposition de projet Full-Stack"
      />
    </div>

    <div>
      <label for="message" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-1.5">
        Message *
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        required
        class="w-full px-4 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        placeholder="Détaillez votre projet ou besoin..."
      ></textarea>
    </div>

    <button
      id="submit-btn"
      type="submit"
      class="w-full sm:w-auto px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-700 disabled:bg-indigo-400 text-white font-semibold text-sm inline-flex items-center justify-center gap-2 transition-all shadow-sm focus:ring-2 focus:ring-indigo-500 cursor-pointer disabled:cursor-not-allowed"
    >
      <span id="btn-text">Envoyer le message</span>
      <svg id="btn-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
    </button>
  </form>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;
  const feedbackText = document.getElementById('feedback-text') as HTMLSpanElement;
  const feedbackIcon = document.getElementById('feedback-icon') as HTMLSpanElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const name = (formData.get('name') as string)?.trim();
    const email = (formData.get('email') as string)?.trim();
    const subject = (formData.get('subject') as string)?.trim() || 'Contact Portfolio';
    const message = (formData.get('message') as string)?.trim();

    // Validation
    if (!name || !email || !message) {
      showFeedback(false, 'Veuillez remplir tous les champs obligatoires.');
      return;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      showFeedback(false, 'Veuillez renseigner une adresse email valide.');
      return;
    }

    // État chargement (Loading)
    submitBtn.disabled = true;
    btnText.textContent = 'Envoi en cours... ⏳';

    try {
      const response = await fetch('https://formsubmit.co/ajax/vagehe1989@bowlfuel.com', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          Nom: name,
          Email: email,
          Sujet: subject,
          Message: message,
          _subject: `[Portfolio John Doe] Contact de ${name}`,
          _template: 'table',
        }),
      });

      const data = await response.json();

      if (response.ok && data.success !== 'false') {
        showFeedback(true, 'Votre message a été envoyé avec succès ! Je vous répondrai très prochainement.');
        form.reset();
      } else {
        throw new Error(data.message || 'Erreur lors de l’envoi.');
      }
    } catch (err: any) {
      showFeedback(false, err?.message || 'Une erreur est survenue lors de l’envoi. Veuillez réessayer.');
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Envoyer le message';
    }
  });

  function showFeedback(success: boolean, message: string) {
    feedback.classList.remove('hidden', 'bg-emerald-50', 'dark:bg-emerald-950/60', 'border-emerald-300', 'dark:border-emerald-800', 'text-emerald-800', 'dark:text-emerald-300', 'bg-rose-50', 'dark:bg-rose-950/60', 'border-rose-300', 'dark:border-rose-800', 'text-rose-800', 'dark:text-rose-300');

    if (success) {
      feedback.classList.add('bg-emerald-50', 'dark:bg-emerald-950/60', 'border-emerald-300', 'dark:border-emerald-800', 'text-emerald-800', 'dark:text-emerald-300');
      feedbackIcon.textContent = '✅';
    } else {
      feedback.classList.add('bg-rose-50', 'dark:bg-rose-950/60', 'border-rose-300', 'dark:border-rose-800', 'text-rose-800', 'dark:text-rose-300');
      feedbackIcon.textContent = '⚠️';
    }

    feedbackText.textContent = message;
  }
</script>
