---
interface Props {
  title: string;
  description?: string;
}

const { 
  title = "John Doe — Développeur Web Full-Stack Senior",
  description = "Portfolio professionnel de John Doe : 7 ans d’expérience en TypeScript, React, Node.js et architectures Cloud."
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>

    <!-- Script bloquant Anti-FOUC (Zéro flash de thème) -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      } catch (_) {}
    </script>
  </head>
  <body class="bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-screen font-sans selection:bg-indigo-500 selection:text-white transition-colors duration-200">
    <slot />
  </body>
</html>
